# =============================================================================
# Arc Liquidity Protocol - environment template
# =============================================================================
# Copy to the network file you need:
#
#   cp .env.example .env.test    # testnet
#   cp .env.example .env.main    # mainnet
#
# The helper scripts load .env.test for --testnet (the default) and .env.main
# for --mainnet. Override with ENV_FILE=/path/to/file.
#
# Both files are gitignored. Never commit real keys.
# =============================================================================

# ---------------------------------------------------------------- deployer
# Pays gas for deployments, the Safe proxy and the timelock.
PRIVATE_KEY=
DEPLOYER_ADDR=

# ---------------------------------------------------------------- protocol admins
ADMIN1=
ADMIN1_KEY=

ADMIN2=
ADMIN2_KEY=

# Third Safe owner / recovery key.
RECOVERY=
RECOVERY_KEY=

# Key used by upgrade.sh (must own the ProxyAdmins before the timelock).
# Defaults to ADMIN1_KEY when empty.
UPGRADE_KEY=

# ---------------------------------------------------------------- other roles
EVM_MASTER=
EVM_MASTER_KEY=

TREASURY=
TREASURY_KEY=

RELAYER=
RELAYER_KEY=

# ---------------------------------------------------------------- tokens
# USDC is the same on testnet and mainnet. EURC differs by network.
USDC=0x3600000000000000000000000000000000000000
EURC=

# ---------------------------------------------------------------- proxies
# Read these from the deployment output or from the live chain.
LM_PROXY=
LP_PROXY=
LM_PROXY_ADMIN=
LP_PROXY_ADMIN=

# ---------------------------------------------------------------- Safe (2-of-3)
# Owners default to ADMIN1 / ADMIN2 / RECOVERY when left blank.
SAFE_ADMIN1=
SAFE_ADMIN2=
SAFE_RECOVERY=
SAFE_THRESHOLD=2
# Canonical Safe v1.5.0 defaults are used when blank:
#   singleton        0xFf51A5898e281Db6DfC7855790607438dF2ca44b
#   SafeL2 singleton 0xEdd160fEBBD92E350D4D398fb636302fccd67C7e
#   proxy factory    0x14F2982D601c9458F93bd70B218933A6f8165e7b
#   fallback handler 0x3EfCBb83A4A7AfcB4F68D501E2c2203a38be77f4
SAFE_SINGLETON=
SAFE_PROXY_FACTORY=
SAFE_FALLBACK_HANDLER=
SAFE_SALT_NONCE=0
# Written by deploy-safe.sh after a successful deploy.
SAFE_ADDRESS=

# ---------------------------------------------------------------- timelock
# Written by governance.sh --deploy-timelock.
TIMELOCK=
TIMELOCK_MIN_DELAY=7200
# Key that deploys the timelock. Defaults to PRIVATE_KEY when empty.
GOVERNANCE_KEY=

# ---------------------------------------------------------------- optional upgrade schedule
PROXY=
PROXY_ADMIN=
IMPLEMENTATION=
SALT=

# ---------------------------------------------------------------- network override
# Leave blank to use the Arc default RPC.
RPC_URL=
