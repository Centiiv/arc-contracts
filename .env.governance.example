# Wave 3 governance state for Arc.
# Copy to .env.governance (gitignored) and fill in.
#   cp .env.governance.example .env.governance
#
# governance.sh also reads .env.upgrade and .env.safe, so the proxy/admin
# addresses and SAFE_ADDRESS can live there instead of here.

# Deployer for the TimelockController. Pays gas only.
PRIVATE_KEY=0x

# Written by deploy-safe.sh; required here if .env.safe is absent.
SAFE_ADDRESS=0x

# Live proxy addresses (also in .env.upgrade).
LM_PROXY=0xB648061376a696Daafb17D8107B18872ecC6889B
LP_PROXY=0x7A343A92B580f47A3Cb473dacB43F09f9467033f
LM_PROXY_ADMIN=0xd454D48FbeA2bD631Cdf70a3a11089AC9d1e4f84
LP_PROXY_ADMIN=0x588a5Ece2ab68D61eD48674a0FE37a2F3f8F0C89

# Timelock. Leave blank until `governance.sh --deploy-timelock` writes it.
TIMELOCK=
TIMELOCK_MIN_DELAY=7200

# Optional, for `governance.sh --schedule`:
PROXY=
PROXY_ADMIN=
IMPLEMENTATION=
SALT=
