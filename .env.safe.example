# Safe deployment configuration for Arc.
# Copy to .env.safe (gitignored) and fill in.
#   cp .env.safe.example .env.safe

# Deployer key. Pays gas only; it is NOT a Safe owner.
PRIVATE_KEY=0x

# The three Safe owners. Must be distinct addresses.
SAFE_ADMIN1=0x
SAFE_ADMIN2=0x
SAFE_RECOVERY=0x

# Optional. Defaults to 2 (2-of-3).
SAFE_THRESHOLD=2

# Optional. Canonical Safe v1.4.1 addresses on Arc mainnet/testnet.
# Leave blank to use the defaults in script/DeploySafe.s.sol.
SAFE_SINGLETON=
SAFE_PROXY_FACTORY=
SAFE_FALLBACK_HANDLER=
SAFE_SALT_NONCE=0

# Filled in automatically by `bash deploy-safe.sh --mainnet`.
SAFE_ADDRESS=
